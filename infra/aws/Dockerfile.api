FROM node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci --ignore-scripts
COPY apps/api apps/api
COPY packages/shared packages/shared
COPY scripts/prepare-api.mjs scripts/prepare-api.mjs
COPY infra/sql infra/sql
RUN npm run build -w @enem/api && npm prune --omit=dev --ignore-scripts

FROM python:3.14-slim-bookworm@sha256:945c2676dc2b18e0c1f16879244122c57c0ffede60006bf3df159c507a31bcae AS python
RUN python -m venv /opt/venv
COPY python/requirements.txt /tmp/requirements.txt
RUN /opt/venv/bin/pip install --no-cache-dir -r /tmp/requirements.txt

FROM python:3.14-slim-bookworm@sha256:945c2676dc2b18e0c1f16879244122c57c0ffede60006bf3df159c507a31bcae
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 ca-certificates && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 10001 sirenia && useradd -m -u 10001 -g sirenia sirenia
COPY --from=build /usr/local/bin/node /usr/local/bin/node
COPY --from=python /opt/venv /opt/venv
WORKDIR /app
COPY --from=build --chown=sirenia:sirenia /app/node_modules ./node_modules
COPY --from=build --chown=sirenia:sirenia /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=build --chown=sirenia:sirenia /app/apps/api/dist ./apps/api/dist
COPY --from=build --chown=sirenia:sirenia /app/apps/api/assets ./apps/api/assets
COPY --from=build --chown=sirenia:sirenia /app/packages ./packages
COPY --chown=sirenia:sirenia python ./python
COPY --chown=sirenia:sirenia infra/aws/cleanup.mjs ./infra/aws/cleanup.mjs
RUN mkdir /app/media && chown sirenia:sirenia /app/media
ENV NODE_ENV=production API_HOST=0.0.0.0 API_PORT=3001 PYTHON_EXECUTABLE=/opt/venv/bin/python MEDIA_ROOT=/app/media OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
USER sirenia
EXPOSE 3001
CMD ["node","apps/api/dist/main.js"]
