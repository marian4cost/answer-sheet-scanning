{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendSireniaEmailOnly",
      "Effect": "Allow",
      "Action": ["ses:SendEmail"],
      "Resource": [
        "arn:aws:ses:__AWS_REGION__:__AWS_ACCOUNT_ID__:identity/__SES_DOMAIN__",
        "arn:aws:ses:__AWS_REGION__:__AWS_ACCOUNT_ID__:configuration-set/__SES_CONFIGURATION_SET__"
      ],
      "Condition": {"StringEquals": {"ses:FromAddress": "__EMAIL_FROM_ADDRESS__"}}
    },
    {
      "Sid": "PrivateSireniaObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::__S3_BUCKET__/__S3_PREFIX__*"
    },
    {
      "Sid": "VerifyPrivateBucket",
      "Effect": "Allow",
      "Action": "s3:GetBucketPublicAccessBlock",
      "Resource": "arn:aws:s3:::__S3_BUCKET__"
    }
  ]
}
