{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendSireniaEmailOnly",
      "Effect": "Allow",
      "Action": ["ses:SendEmail"],
      "Resource": [
        "arn:aws:ses:us-east-2:924328993642:identity/mage.dev.br",
        "arn:aws:ses:us-east-2:924328993642:configuration-set/sirenia"
      ],
      "Condition": {"StringEquals": {"ses:FromAddress": "boletins@mage.dev.br"}}
    },
    {
      "Sid": "PrivateSireniaObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::morea/sirenia/*"
    },
    {
      "Sid": "VerifyPrivateBucket",
      "Effect": "Allow",
      "Action": "s3:GetBucketPublicAccessBlock",
      "Resource": "arn:aws:s3:::morea"
    }
  ]
}
