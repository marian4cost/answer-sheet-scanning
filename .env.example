# Configuração LOCAL. Copie para .env apenas se .env ainda não existir.
# Nunca publique credenciais, banco, provas, contatos ou backups no Git.

# DATABASE_URL vazia usa SQLite; quando preenchida, PostgreSQL tem precedência.
DATABASE_URL=
DATABASE_SSL=false
# Supabase: CA oficial em PEM codificada em base64. Mantém TLS verificado.
DATABASE_SSL_CA_BASE64=
DATABASE_PATH=./db.sqlite3
MEDIA_ROOT=./media
STORAGE_MODE=local
PYTHON_EXECUTABLE=./venv/bin/python
API_HOST=127.0.0.1
API_PORT=3001
WEB_PORT=3000
API_BASE_URL=http://127.0.0.1:3001

# Sem URL remota, NestJS chama o worker local por stdin/stdout.
OMR_REMOTE_URL=
OMR_REMOTE_SECRET=

# Apenas para desenvolvimento local em loopback. Vercel exige autenticação
# mesmo se AUTH_ENABLED=false. Configure a allowlist antes de publicar.
AUTH_ENABLED=false
TEACHER_EMAILS=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=omr-private
WEB_URL=
CORS_ORIGINS=
# WEB_URL direciona o link mágico para a interface em /login. Cadastre esse
# callback nas URLs autorizadas do Supabase Auth. Link padrão funciona sem
# editar template; OTP opcional usa {{ .Token }} quando disponível no email.
# SMTP padrão do Auth só atende emails da equipe Supabase e tem limites baixos.
# SMTP/Resend abaixo pertence aos boletins, não configura SMTP do Supabase Auth.

REPORT_INSTITUTION="Instituto Federal de Sergipe - Campus Lagarto"

# Email dos boletins é OPCIONAL e depende de confirmação na interface.
# Use EMAIL_FROM e um provedor. Resend tem precedência sobre SMTP.
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# SMTP_FROM é alternativa a EMAIL_FROM.
SMTP_FROM=

# Origem dos espelhos na migração --include-media.
MIGRATION_MEDIA_ROOT=./media

# NUVEM: cadastre valores reais nas variáveis dos projetos. As linhas abaixo
# são instruções, sem credenciais. Não use NEXT_PUBLIC_* para segredos.
# API NestJS (Root Directory apps/api):
#   DATABASE_URL = conexão PostgreSQL do Supabase
#   DATABASE_SSL = true
#   DATABASE_SSL_CA_BASE64 = certificado CA oficial do projeto em base64
#   NODE_OPTIONS = --experimental-require-module (compatibilidade NestJS12 na Vercel)
#   STORAGE_MODE = supabase
#   AUTH_ENABLED = true
#   TEACHER_EMAILS = emails autorizados separados por vírgula
#   SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY = projeto real
#   SUPABASE_STORAGE_BUCKET = omr-private (privado)
#   OMR_REMOTE_URL = URL HTTPS da função Python, terminada em /api/omr
#   OMR_REMOTE_SECRET = segredo aleatório longo, igual ao da função Python
#   WEB_URL = origem real da interface para callback de login em /login
#   CORS_ORIGINS = origens HTTPS exatas da interface, sem barra final
#   EMAIL_FROM e SMTP_* ou RESEND_API_KEY = se quiser habilitar boletins
# Interface Next.js (Root Directory apps/web):
#   API_BASE_URL = URL HTTPS da API, sem /api e sem barra final
# Python/OpenCV (Root Directory python):
#   OMR_REMOTE_SECRET / SUPABASE_URL / SUPABASE_STORAGE_BUCKET
# VERCEL é definida pela hospedagem; não a configure localmente.
